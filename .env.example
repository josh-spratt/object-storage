PORT=3000
DATABASE_URL=postgres://app:app@localhost:5432/media

S3_REGION=us-east-1
S3_BUCKET=media
S3_ACCESS_KEY_ID=dev-access-key
S3_SECRET_ACCESS_KEY=dev-secret-key
# Where the API server reaches the object store.
S3_ENDPOINT=http://localhost:8333
# Where browsers reach it. Presigned URLs are signed for this host. In production
# this is usually unset (use the AWS default) or a custom domain.
S3_PUBLIC_ENDPOINT=http://localhost:8333
# Needed for most S3-compatible stores (bucket in the path, not the subdomain).
S3_FORCE_PATH_STYLE=true

# Dev-only teaching aid: exposes raw DB rows and bucket listings to the UI.
# Never enable in production.
ENABLE_EXPLORER=true
